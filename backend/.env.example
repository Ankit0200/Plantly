# Plantly backend settings: example file.
#
# Setup:  copy this file to backend/.env  and fill in your own values.
#     PowerShell:  Copy-Item backend/.env.example backend/.env
#     macOS/Linux: cp backend/.env.example backend/.env
#
# backend/.env is gitignored. Never commit real keys. app.py loads it at startup;
# variables already set in your shell take precedence over this file.
# Lines starting with # are ignored, so leave optional settings commented out to use the defaults.

# ---------------------------------------------------------------- AI keys
# Gemini powers intake (chat + soil-test upload), crop recommendations, "Why?" explanations,
# and plan chat (see CHAT_PROVIDER). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GOOGLE_API_KEY=                     # accepted instead of GEMINI_API_KEY if you already use that name

# Optional: Claude for the two plan chats instead of Gemini. https://console.anthropic.com
# ANTHROPIC_API_KEY=

# Which model answers plan chat: "gemini" or "anthropic".
# If unset: anthropic when ANTHROPIC_API_KEY is set, otherwise gemini.
CHAT_PROVIDER=gemini

# Optional model overrides (defaults shown).
# GEMINI_MODEL=gemini-3-flash-preview
# CLAUDE_MODEL=claude-sonnet-5-5

# ---------------------------------------------------------------- Flask
# Signs login session cookies. The default is only safe for local development; in production
# set a long random value, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# Set to "production" when serving over HTTPS: session cookies are then sent over HTTPS only.
# FLASK_ENV=production

# Optional: folder with the planner's research data (defaults to backend/data).
# SOIL_DATA_DIR=
